<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa de la ruta -->
    <FrameLayout
        android:id="@+id/map_ruta_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/mb_gray_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel superior: origen, destino y botón -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_origen_destino"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/planificador_titulo"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Origen: botón de "mi ubicación" + campo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_location"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/mi_ubicacion"
                            android:padding="8dp"
                            android:src="@drawable/ic_my_location"
                            app:tint="@color/mb_gray" />

                        <EditText
                            android:id="@+id/input_origen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_origen"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Destino: logo de estación + campo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/planificador_destino"
                            android:padding="8dp"
                            android:src="@drawable/ic_estaciones"
                            app:tint="@color/mb_red" />

                        <EditText
                            android:id="@+id/input_destino"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_destino"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_intercambiar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/intercambiar"
                    android:padding="10dp"
                    android:src="@drawable/ic_swap"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trazar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/planificador_trazar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Deslizador de estaciones de la ruta (arriba) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_estaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/panel_origen_destino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_estaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel inferior: resultado de la ruta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_resultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/res_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="8 paradas · 0 transbordos · ~13 min" />

            <!-- Descripción de ruta: lista scrolleable con logos de estación (nuevo/antiguo)
                 e íconos de transferencia (caminata/transbordo) entre sistemas, líneas o servicio. -->
            <ScrollView
                android:id="@+id/res_pasos_scroll"
                android:tag="largo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:id="@+id/res_pasos_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/res_aviso"
                android:tag="largo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/mb_red"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="⚠ Ruta alterna por afectaciones en el servicio" />

            <TextView
                android:id="@+id/res_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Vas en Deportivo 18 de Marzo · Siguiente: La Raza" />

            <!-- Servicio Ordinario/Express (solo si el viaje va por una sola línea Mexibús con ambos). -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_express"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/servicio_express_switch"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_recorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/recorrido_iniciar"
                app:icon="@drawable/ic_my_location" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Controles de zoom y orientación (izquierda) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_zoom_ruta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        android:translationZ="8dp"
        app:layout_constraintBottom_toTopOf="@id/panel_resultado"
        app:layout_goneMarginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_acercar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_in"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_alejar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_out"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_norte"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_norte"
                android:padding="9dp"
                android:src="@drawable/ic_compass" />

            <ImageButton
                android:id="@+id/btn_ubicacion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mi_ubicacion"
                android:padding="10dp"
                android:src="@drawable/ic_my_location"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_iconos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_iconos"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mexibus_nuevo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
