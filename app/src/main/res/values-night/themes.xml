<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro: rojo Metrobús suavizado sobre superficie oscura -->
    <style name="Base.Theme.GeoMB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mb_red_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/mb_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/mb_red_container</item>
        <item name="colorSecondary">@color/mb_gray_light</item>
        <item name="colorSurface">@color/mb_surface_dark</item>
        <!-- Sin statusBarColor/navigationBarColor (deprecados en Android 15). Borde a borde
             + insets. Iconos claros sobre barras oscuras. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
