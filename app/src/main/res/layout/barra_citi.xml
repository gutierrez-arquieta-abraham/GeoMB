<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo CITI (app Metrobús de Indra, 2018): barra "Mapa / Menú" del mapa + caja de ruta filtrada.
     La franja de logos la pone CitiActivity (header_citi.xml). Ver docs/MODO_CITI_referencia.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barra_citi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/bar_menu_citi" />

    <!-- Caja de "modo mapa" (fragment_mapa.xml vModoMapa): ruta filtrada + X para quitarla. -->
    <LinearLayout
        android:id="@+id/citi_modo_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/citi_caja_mapa"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <!-- Modo autobús ("Mi trayecto"): ivModoBus del original. -->
        <ImageView
            android:id="@+id/citi_modo_bus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/citi_bus"
            android:visibility="gone" />

        <TextView
            android:id="@+id/citi_modo_linea"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:lines="1"
            android:minWidth="40dp"
            android:paddingHorizontal="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/citi_modo_cerrar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/citi_quitar_ruta"
            android:scaleType="fitXY"
            android:src="@drawable/citi_cerrar" />
    </LinearLayout>
</LinearLayout>
