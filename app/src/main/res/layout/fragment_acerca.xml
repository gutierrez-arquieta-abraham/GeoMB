<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:tag="largo">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txt_app_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="?attr/colorPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/acerca_version"
            android:textColor="@color/mb_gray"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_desc"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/mb_outline" />

        <TextView
            android:id="@+id/txt_agradecimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agradecimientos_titulo"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/agradecimientos_texto"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/acerca_datos"
            android:textColor="@color/mb_gray"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- Idioma y cambio de tipo de usuario, en la parte inferior (para despistados). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_idioma"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/idioma_boton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editar_perfil"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/perfil_editar" />

        <!-- Sincronización en segundo plano (siempre visible) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/mb_outline" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_sincro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sincro_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sincro_switch_desc"
            android:textColor="@color/mb_gray"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Tiempo de actualización del mapa (visible para todos) -->
        <TextView
            android:id="@+id/txt_refresco_valor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seek_refresco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="105" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/mapa_refresco_desc"
            android:textColor="@color/mb_gray"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Mostrar Mexibús: capa en el mapa + ruteo en el planificador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/mb_outline" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_mexibus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mexibus_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mexibus_switch_desc"
            android:textColor="@color/mb_gray"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Notificaciones push (afectaciones / actualizaciones), desactivables por el usuario -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/mb_outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/notif_titulo"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- "Recibir por líneas": al activarlo despliega el menú de líneas -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_notif_afect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notif_recibir_lineas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/notif_desc"
            android:textColor="@color/mb_gray"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Menú por línea (se muestra solo con "Recibir por líneas" activo) -->
        <LinearLayout
            android:id="@+id/panel_notif_lineas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/notif_lineas_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/cont_notif_lineas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lineas_maestro"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/notif_lineas_desactivar" />
        </LinearLayout>

        <!-- Modo personalizado (oculto hasta 5 toques al logo) -->
        <LinearLayout
            android:id="@+id/panel_personalizado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mb_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/modo_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/modo_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_frase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:hint="@string/modo_frase_hint"
                android:inputType="text"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activar_frase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_activar" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_cachondo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/modo_sw_cachondo"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_pbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_sw_pbs"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_claves"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/modo_ver_claves"
                android:visibility="gone" />

            <!-- Simulador de afectación (prueba del planificador por sentido) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/mb_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Simular afectación (prueba)"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_sim_linea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/sp_sim_estacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/sp_sim_estacion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/sp_sim_sentido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_simular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Simular afectación (estación · sentido)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sin_servicio"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sin servicio (tramo: desde → hasta)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cortar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cortar línea aquí (parte en 2)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quitar_sim"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quitar simulación / corte" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_salir_personalizado"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_salir" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
