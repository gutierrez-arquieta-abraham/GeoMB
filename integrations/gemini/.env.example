# Copia este archivo a ".env" (NUNCA subas el .env real con la llave real al repo) y llena
# los valores reales. Ver CLAUDE.md: "nunca tokens/llaves en claro ni al repo".

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend real de GeoMB (por defecto, igual que la app Android -- normalmente no hace falta tocarlos)
GEOMB_BASE_URL=https://geomb.duckdns.org
GEOMB_FALLBACK_URL=https://web-production-6a6c6.up.railway.app
GEOMB_HTTP_TIMEOUT_S=10

# Ruta a la carpeta de assets de la app (por defecto la detecta sola si este script vive
# dentro del repo GeoMB, en integrations/gemini/)
# GEOMB_ASSETS_DIR=/ruta/a/GeoMB/app/src/main/assets

GEOMB_AGENT_HOST=0.0.0.0
GEOMB_AGENT_PORT=8000
