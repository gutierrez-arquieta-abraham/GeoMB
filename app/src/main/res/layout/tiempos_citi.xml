<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo CITI: "Estimaciones de llegadas" (fragment_tiempos.xml de la app de Indra). La barra
     "título / Menú" es la de barra_citi.xml (MapFragment le cambia el título). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/citi_tiempos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp">

        <ImageView
            android:id="@+id/citi_tiempos_icono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/citi_tiempos_estacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/citi_texto"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/citi_tiempos_resultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:visibility="invisible">

        <ListView
            android:id="@+id/citi_tiempos_lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/citi_caja_lista"
            android:divider="@color/citi_lista_divisor"
            android:dividerHeight="1px"
            android:padding="2dp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/citi_tiempos_refrescar"
        style="@style/CitiBotonMenu"
        android:layout_gravity="center_horizontal"
        android:layout_margin="10dp"
        android:text="@string/citi_refrescar" />
</LinearLayout>
