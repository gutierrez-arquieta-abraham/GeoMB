<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa de la ruta -->
    <FrameLayout
        android:id="@+id/map_ruta_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/mb_gray_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel superior: origen, destino y botón -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_origen_destino"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Formulario EXPANDIDO (origen/destino/swap/trazar). Se contrae solo al trazar una ruta, o
             a mano con el chevron junto al título, para liberar mapa; la mini viñeta de abajo (GONE
             mientras este está visible) permite volver a expandirlo con lo que ya se tenía. -->
        <LinearLayout
            android:id="@+id/panel_od_expandido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/planificador_titulo"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAlignment="center"/>

                <ImageButton
                    android:id="@+id/btn_contraer_od"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/planificador_contraer"
                    android:padding="5dp"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_right"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Origen: botón de "mi ubicación" + campo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_location"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/mi_ubicacion"
                            android:padding="8dp"
                            android:src="@drawable/ic_my_location"
                            app:tint="@color/mb_gray" />

                        <EditText
                            android:id="@+id/input_origen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_origen"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Destino: logo de estación + campo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/planificador_destino"
                            android:padding="8dp"
                            android:src="@drawable/ic_estaciones"
                            app:tint="@color/mb_red" />

                        <EditText
                            android:id="@+id/input_destino"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_destino"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_intercambiar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/intercambiar"
                    android:padding="10dp"
                    android:src="@drawable/ic_swap"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trazar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/planificador_trazar" />

            <!-- Se muestra mientras se calcula la ruta en segundo plano (Dijkstra + grafo de
                 correspondencias puede tardar); sin esto la pantalla se quedaba sin ningún
                 indicador y el resultado (con sus pictogramas) parecía tardar sin motivo. -->
            <ProgressBar
                android:id="@+id/progress_trazando"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Mini viñeta COLAPSADA: cabe en cualquier tamaño de pantalla; toca para volver a expandir
             el formulario completo con el origen/destino que ya se tenía. -->
        <LinearLayout
            android:id="@+id/panel_od_colapsado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/planificador_expandir"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_estaciones"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txt_od_colapsado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="Bosques del Valle → París" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Deslizador de estaciones de la ruta (arriba) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_estaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/panel_origen_destino"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_estaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel inferior: resultado de la ruta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_resultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Encabezado SIEMPRE visible: resumen + chevron. Toca cualquiera de los dos para
                 contraer/expandir el detalle (lista de pasos + aviso) de abajo. Se contrae solo al
                 iniciar el recorrido (más mapa mientras navegas); el resumen se queda como mini
                 viñeta con lo que ya se tenía. -->
            <LinearLayout
                android:id="@+id/fila_resultado_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/res_resumen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="8 paradas · 0 transbordos · ~13 min" />

                <ImageView
                    android:id="@+id/ic_contraer_resultado"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/planificador_contraer"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Detalle CONTRAÍBLE: descripción de ruta (lista scrolleable con logos de estación,
                 nuevo/antiguo, e íconos de transferencia entre sistemas/líneas/servicio) + aviso. -->
            <LinearLayout
                android:id="@+id/panel_resultado_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/res_pasos_scroll"
                    android:tag="largo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:id="@+id/res_pasos_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/res_aviso"
                    android:tag="largo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/mb_red"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="⚠ Ruta alterna por afectaciones en el servicio (toca para ver detalle)" />
            </LinearLayout>

            <TextView
                android:id="@+id/res_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Vas en Deportivo 18 de Marzo · Siguiente: La Raza" />

            <!-- Servicio Ordinario/Express (solo si el viaje va por una sola línea Mexibús con ambos). -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_express"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/servicio_express_switch"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_recorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/recorrido_iniciar"
                app:icon="@drawable/ic_my_location" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Controles de zoom y orientación (izquierda) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_zoom_ruta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        android:translationZ="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/panel_estaciones"
        app:layout_goneMarginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/panel_resultado"
        app:layout_goneMarginBottom="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_acercar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_in"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_alejar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_out"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_norte"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_norte"
                android:padding="9dp"
                android:src="@drawable/ic_compass" />

            <ImageButton
                android:id="@+id/btn_ubicacion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mi_ubicacion"
                android:padding="10dp"
                android:src="@drawable/ic_my_location"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_iconos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_iconos"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mexibus_nuevo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
