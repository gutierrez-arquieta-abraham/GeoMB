<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:tag="largo">

        <!-- ================= MÓDULO 1: Personalización ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_afect_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txt_personalizacion_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_personalizacion_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Perfil de Google: foto + nombre + correo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_perfil_foto"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_gris"
                    android:contentDescription="@string/config_perfil_foto_desc"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_perfil_generico" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_perfil_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_perfil_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mb_gray"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_editar_perfil"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/perfil_editar" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/mb_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_idioma"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/idioma_boton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_descargar_audios"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/audios_descargar" />

            <!-- Sincronización en segundo plano -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/mb_outline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_sincro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sincro_switch" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sincro_switch_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Tiempo de actualización del mapa -->
            <TextView
                android:id="@+id/txt_refresco_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seek_refresco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="105" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mapa_refresco_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Mostrar Mexibús -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/mb_outline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_mexibus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/mexibus_switch" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mexibus_switch_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Ahorro de datos -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/mb_outline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_ahorro_datos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ahorro_datos_switch" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ahorro_datos_switch_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Notificaciones -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/mb_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/notif_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_notif_afect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/notif_recibir_lineas" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/notif_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Menú por línea (se muestra solo con "Recibir por líneas" activo) -->
            <LinearLayout
                android:id="@+id/panel_notif_lineas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/notif_lineas_desc"
                    android:textColor="@color/mb_gray"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/cont_notif_lineas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lineas_maestro"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/notif_lineas_desactivar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= MÓDULO 2: Agradecimientos ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_afect_card"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/txt_app_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="?attr/colorPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/acerca_version"
                android:textColor="@color/mb_gray"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/app_desc"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/mb_outline" />

            <TextView
                android:id="@+id/txt_agradecimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/agradecimientos_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/agradecimientos_texto"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acerca_datos"
                android:textColor="@color/mb_gray"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Modo personalizado (oculto hasta 5 toques al logo) -->
        <LinearLayout
            android:id="@+id/panel_personalizado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_afect_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/modo_titulo"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/modo_desc"
                android:textColor="@color/mb_gray"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_frase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints=""
                android:hint="@string/modo_frase_hint"
                android:inputType="text"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_activar_frase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_activar" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_cachondo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/modo_sw_cachondo"
                android:visibility="gone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_pbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_sw_pbs"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_claves"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/modo_ver_claves"
                android:visibility="gone" />

            <!-- Simulador de afectación (prueba del planificador por sentido) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/mb_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Simular afectación (prueba)"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_sim_linea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/sp_sim_estacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/sp_sim_estacion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/sp_sim_sentido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_simular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Simular afectación (estación · sentido)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sin_servicio"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sin servicio (tramo: desde → hasta)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cortar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cortar línea aquí (parte en 2)" />

            <TextView
                android:id="@+id/tv_sim_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sin simulación activa"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quitar_sim"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quitar simulación / corte" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_salir_personalizado"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modo_salir" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
