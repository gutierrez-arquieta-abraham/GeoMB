<?xml version="1.0" encoding="utf-8"?>
<!-- Reporte de un problema DE LA APP (mala información, proceso incompleto, sugerencia...), a
     diferencia de fragment_reporte.xml (que reporta el SERVICIO de Metrobús). Ver ReporteApp
     y ConfiguracionFragment.mostrarReporteApp(). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reporte_app_categoria"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_reporte_app_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reporte_app_descripcion"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/in_reporte_app_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:hint="@string/reporte_app_desc_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reporte_app_imagen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:icon="@drawable/ic_report"
            android:text="@string/reporte_app_adjuntar" />

        <TextView
            android:id="@+id/txt_reporte_app_imagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mb_gray"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
