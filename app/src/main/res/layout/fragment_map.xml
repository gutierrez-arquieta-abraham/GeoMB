<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenedor del mapa de Google -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/mb_gray_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de búsqueda flotante -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/buscar_boton"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary" />

            <EditText
                android:id="@+id/input_mapa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="@string/buscar_hint"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/mb_gray"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Píldora de filtros activos (toca para limpiar) -->
    <TextView
        android:id="@+id/chip_filtros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/filtros_activos"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_close_small"
        app:drawableTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_bar" />

    <!-- Contador de unidades visibles -->
    <TextView
        android:id="@+id/txt_conteo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_conteo"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/unidades_en_servicio"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón de filtros -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_filtros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/filtros"
        android:src="@drawable/ic_filter"
        app:backgroundTint="?attr/colorSurface"
        app:fabSize="mini"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Controles de zoom y orientación (izquierda) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_acercar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_in"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_alejar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_out"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_norte"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_norte"
                android:padding="9dp"
                android:src="@drawable/ic_compass" />

            <ImageButton
                android:id="@+id/btn_ubicacion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mi_ubicacion"
                android:padding="10dp"
                android:src="@drawable/ic_my_location"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel de personalización del mapa (tema oscuro / tráfico) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/txt_conteo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btn_trafico"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_trafico"
                android:padding="10dp"
                android:src="@drawable/ic_traffic"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_tipo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_tipo"
                android:padding="10dp"
                android:src="@drawable/ic_layers"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_estaciones"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_estaciones"
                android:padding="10dp"
                android:src="@drawable/ic_estaciones"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_mexibus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_mexibus"
                android:padding="9dp"
                android:src="@drawable/ic_mexibus" />

            <ImageButton
                android:id="@+id/btn_3d"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_3d"
                android:padding="10dp"
                android:src="@drawable/ic_3d"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_centrar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_centrar"
                android:padding="10dp"
                android:src="@drawable/ic_center"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
