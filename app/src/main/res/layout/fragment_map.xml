<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenedor del mapa de Google -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/mb_gray_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aviso persistente de "servidor sin respuesta" (ver MapFragment.poll/avisoError): a
         diferencia del Toast de antes (se esfuma a los pocos segundos), esta franja se queda
         visible mientras el feed siga fallando, pensada para una caída larga del EC2 (p. ej.
         por falta de pago), no solo un bache de red pasajero. GONE colapsa su alto en la cadena,
         así que search_bar sube de vuelta a su lugar normal cuando no hace falta mostrarla. -->
    <TextView
        android:id="@+id/banner_servidor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mb_red"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/mapa_servidor_sin_respuesta"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- Estilo CITI (Modos.estiloCiti): barra de logos + "Mapa / Menú" de la app de Indra, en
         lugar del buscador y los paneles de GeoMB. Ver MapFragment.configurarCiti(). -->
    <include
        layout="@layout/barra_citi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/banner_servidor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de búsqueda flotante + acceso al asistente (Gemini): antes eran dos barras
         completas apiladas (52dp cada una); el ícono de chat al final de ESTA MISMA barra abre
         ChatAsistenteActivity (igual que antes, misma Activity/lógica) sin ocupar una segunda
         fila permanente: recupera ~60dp de alto fijo sobre el mapa. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/banner_servidor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/buscar_boton"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary" />

            <EditText
                android:id="@+id/input_mapa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="@string/buscar_hint"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/mb_gray"
                android:textSize="16sp" />

            <!-- Entrada al planificador de ruta: abre/cierra panel_origen_destino. -->
            <ImageButton
                android:id="@+id/btn_planificar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/planificador_titulo"
                android:src="@drawable/ic_route"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_chat_mapa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/asistente_titulo"
                android:src="@drawable/ic_chat"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel de origen/destino del planificador, fusionado en el mapa general (ver
         MapFragment.configurarPanelPlanificador()). Mismo anclaje que search_bar (no debajo de
         ella): btn_planificar oculta la barra de búsqueda y muestra este panel EN SU LUGAR, como si
         se transformara en la "pastilla de ruta"; btn_cerrar_od (o el botón atrás del sistema)
         revierte, ocultando este panel y devolviendo la barra de búsqueda. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_origen_destino"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/banner_servidor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/panel_od_expandido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/planificador_titulo"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAlignment="center"/>

                <ImageButton
                    android:id="@+id/btn_contraer_od"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/planificador_contraer"
                    android:padding="5dp"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btn_cerrar_od"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/planificador_cerrar"
                    android:padding="5dp"
                    android:src="@drawable/ic_close_small"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_location"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/mi_ubicacion"
                            android:padding="8dp"
                            android:src="@drawable/ic_my_location"
                            app:tint="@color/mb_gray" />

                        <EditText
                            android:id="@+id/input_origen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_origen"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/planificador_destino"
                            android:padding="8dp"
                            android:src="@drawable/ic_estaciones"
                            app:tint="@color/mb_red" />

                        <EditText
                            android:id="@+id/input_destino"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:hint="@string/planificador_destino"
                            android:imeOptions="actionGo"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_intercambiar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/intercambiar"
                    android:padding="10dp"
                    android:src="@drawable/ic_swap"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trazar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/planificador_trazar" />

            <ProgressBar
                android:id="@+id/progress_trazando"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel_od_colapsado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/planificador_expandir"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_estaciones"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txt_od_colapsado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="Bosques del Valle → París" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Marca el borde inferior de lo que haya más abajo entre la barra de búsqueda y el panel de
         origen/destino (si está abierto): así la píldora de filtros y el resultado del planificador
         se acomodan solos debajo de lo que esté visible en cada momento, sin encimarse, en cualquier
         tamaño de pantalla. Un elemento GONE (panel_origen_destino cerrado) mide 0, así que no empuja
         la barrera hacia abajo. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bajo_buscador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="search_bar,panel_origen_destino" />

    <!-- Píldora de filtros activos (toca para limpiar) -->
    <TextView
        android:id="@+id/chip_filtros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/filtros_activos"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_close_small"
        app:drawableTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_bajo_buscador" />

    <!-- Contador de unidades visibles -->
    <TextView
        android:id="@+id/txt_conteo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_conteo"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/unidades_en_servicio"
        android:textColor="@color/mb_red"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón de filtros -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_filtros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/filtros"
        android:src="@drawable/ic_filter"
        app:backgroundTint="?attr/colorSurface"
        app:fabSize="mini"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Controles de zoom y orientación (izquierda). Acotado entre search_bar y panel_mapa (NO
         top/bottom_toXOf parent): con ambos extremos anclados al padre, ConstraintLayout solo lo
         centraba en TODA la altura de pantalla sin importar dónde terminan esas otras barras.
         En una pantalla chica esta columna de 5 botones (~228dp) se encimaba con la barra de
         búsqueda arriba y/o con panel_mapa/txt_conteo abajo. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_zoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintBottom_toTopOf="@id/panel_mapa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_acercar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_in"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_alejar"
                android:padding="10dp"
                android:src="@drawable/ic_zoom_out"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_norte"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_norte"
                android:padding="9dp"
                android:src="@drawable/ic_compass" />

            <ImageButton
                android:id="@+id/btn_ubicacion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mi_ubicacion"
                android:padding="10dp"
                android:src="@drawable/ic_my_location"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_iconos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_iconos"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mexibus_nuevo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel de personalización del mapa (tema oscuro / tráfico) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/txt_conteo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <!-- Agrupa tráfico/tipo de mapa/vista 3D (secundarios, de uso poco frecuente) en un
                 menú contextual: antes eran 3 botones permanentes más en esta misma barra.
                 Ninguna de esas 3 funciones se eliminó, solo cambió su jerarquía visual. -->
            <ImageButton
                android:id="@+id/btn_capas"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_capas"
                android:padding="10dp"
                android:src="@drawable/ic_layers"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_estaciones"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_estaciones"
                android:padding="10dp"
                android:src="@drawable/ic_estaciones"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_unidades"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_unidades"
                android:padding="10dp"
                android:src="@drawable/ic_bus"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btn_centrar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mapa_centrar"
                android:padding="10dp"
                android:src="@drawable/ic_center"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta de resultado del buscador inline (unidad o estación): se infla dinámicamente
         (view_carta_unidad.xml / view_carta_estacion.xml) sobre este contenedor. -->
    <FrameLayout
        android:id="@+id/map_carta_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintBottom_toTopOf="@id/panel_mapa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Resultado del planificador: resumen + pasos de la ruta trazada, switch Ordinario/Exprés
         (solo si el viaje va por una línea Mexibús con ambos servicios) e "Iniciar recorrido"
         (seguimiento GPS en vivo). Mismo contenedor map_carta_container de arriba por ahora: en
         la práctica no coinciden visibles
         a la vez (buscar unidad/estación vs. trazar ruta), se revisará si hace falta separar.
         Acotado entre barrier_bajo_buscador (arriba) y panel_mapa (abajo) con constrainedHeight +
         bias 1 (se "cuelga" del fondo, como antes, pero sin crecer encima de la barra de búsqueda/
         panel_origen_destino ni tapar panel_mapa/txt_conteo/fab_filtros): en pantallas chicas o con
         muchos pasos, el espacio disponible manda y la lista de pasos (res_pasos_scroll, con weight)
         es la que se hace scroll, nunca el resumen/switch/botón de abajo. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel_resultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintTop_toBottomOf="@id/barrier_bajo_buscador"
        app:layout_constraintBottom_toTopOf="@id/panel_mapa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/fila_resultado_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/res_resumen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="8 paradas · 0 transbordos · ~13 min" />

                <ImageView
                    android:id="@+id/ic_contraer_resultado"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/planificador_contraer"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Deslizador horizontal de estaciones (EstacionRutaAdapter): vista compacta y siempre
                 visible de la secuencia completa, con chips de instrucción entre tramos; durante el
                 recorrido resalta y centra la estación actual. Se queda visible aunque
                 panel_resultado_detalle (el detalle vertical, más largo) esté contraído, por eso NO
                 vive adentro de ese LinearLayout. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_estaciones_ruta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:paddingHorizontal="2dp"
                android:overScrollMode="ifContentScrolls"
                tools:listitem="@layout/item_estacion_ruta" />

            <LinearLayout
                android:id="@+id/panel_resultado_detalle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/res_pasos_scroll"
                    android:tag="largo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:id="@+id/res_pasos_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/res_aviso"
                    android:tag="largo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/mb_red"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="⚠ Ruta alterna por afectaciones en el servicio (toca para ver detalle)" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/res_estado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Vas en Deportivo 18 de Marzo · Siguiente: La Raza" />

                <!-- Velocímetro: solo visible durante un recorrido activo (ver MapFragment.
                     refrescarRecorridoUI/detenerRecorrido). Cambia a rojo arriba del umbral de
                     RecorridoService.UMBRAL_VELOCIDAD_KMH, mismo momento en que se manda el aviso
                     de exceso de velocidad. -->
                <TextView
                    android:id="@+id/txt_velocidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_conteo"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="42 km/h"
                    tools:visibility="visible" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_express"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/servicio_express_switch"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_recorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/recorrido_iniciar"
                app:icon="@drawable/ic_my_location" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
