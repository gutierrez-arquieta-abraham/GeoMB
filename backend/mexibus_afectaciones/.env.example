# Copia este archivo a .env y ajusta. Prefijo MXB_ obligatorio.

# --- Servidor ---
MXB_HOST=0.0.0.0
MXB_PORT=8080

# --- Poller ---
MXB_POLL_SEGUNDOS=180
MXB_VENTANA_MINUTOS=240

# --- Modo demo (true = usa posts de ejemplo, sin credenciales) ---
# Ponlo en false cuando tengas tokens reales.
MXB_USAR_MOCK=true

# --- X (Twitter) API v2 (de pago). Recomendado si lo tienes. ---
MXB_X_BEARER_TOKEN=

# --- X SIN costo (NO oficial, fragil, puede violar ToS). Solo se usa si NO hay bearer token. ---
# MXB_X_FREE=true activa la lectura sin costo.
# MXB_NITTER_BASE (opcional, lo mas confiable): URL de tu instancia Nitter. Si se deja vacio,
# intenta el endpoint de sindicacion de X.
MXB_X_FREE=false
MXB_NITTER_BASE=

# --- Facebook Graph API. Sin esto, la fuente FB queda inactiva. ---
MXB_FB_PAGE_ACCESS_TOKEN=
MXB_FB_GRAPH_VERSION=v20.0
