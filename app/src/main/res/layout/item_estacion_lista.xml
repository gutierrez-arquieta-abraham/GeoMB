<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_carta_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="14dp">

    <!-- Acento vertical del color de la línea (se tiñe en el adapter). -->
    <View
        android:id="@+id/est_barra"
        android:layout_width="5dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_accent_bar" />

    <ImageView
        android:id="@+id/est_ic"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginVertical="10dp"
        android:contentDescription="@string/nav_lineas" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/est_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/est_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mb_gray"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/est_correspondencia"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:visibility="gone" />
</LinearLayout>
