<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de resultado de una UNIDAD: rellenada por CartaUnidad.bind(). Compartida por
     SearchFragment (buscador por número económico) y MapFragment (buscador inline del mapa). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_resultado"
    style="@style/Widget.GeoMB.Card.Lista"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PÍLDORA (estado colapsado, por defecto): identificación rápida de la unidad sin tapar
             el mapa. Se llena en CartaUnidad.bind() con los MISMOS datos/cadenas que ya calcula para
             el contenido expandido (ver txt_pildora_titulo/txt_pildora_destino), nunca un cómputo
             aparte. Tocarla expande la carta completa (MapFragment.expandirCarta()). -->
        <LinearLayout
            android:id="@+id/fila_pildora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="40dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="@string/nav_buscar"
                    android:padding="10dp"
                    android:src="@drawable/ic_bus"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_pildora_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Unidad 1234"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_pildora_destino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Ruta"
                    android:textColor="@color/mb_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_pildora_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/siguiendo"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/mb_gray" />
        </LinearLayout>

        <!-- CONTENIDO EXPANDIDO: todo lo que ya existía antes de esta fase (ficha, ruta, foto,
             créditos, acciones), GONE por defecto; MapFragment.expandirCarta()/colapsarCarta()
             alternan esta sección con fila_pildora, sin duplicar ninguno de estos datos. -->
        <LinearLayout
            android:id="@+id/contenido_expandido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="@string/nav_buscar"
                    android:padding="12dp"
                    android:src="@drawable/ic_bus"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_unidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unidad 1234"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_linea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Línea 1 · Indios Verdes → El Caminero"
                    android:textColor="@color/mb_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/estado_en_ruta"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_ficha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Empresa · Marca Modelo"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_ruta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ruta"
            android:textColor="@color/mb_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_actualizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Actualizado hace 15 s"
            android:textColor="@color/mb_gray"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/img_unidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/foto_unidad"
            android:maxHeight="140dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_credito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/mb_gray"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_mapa"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/ver_en_mapa"
                app:icon="@drawable/ic_map" />

            <!-- Acción PRIMARIA: "Seguir" (estado inactivo) / "Siguiendo" (estado activo: icono y
                 color cambian en código, ver CartaUnidad.bind()/actualizarBotonSeguirCarta(); misma
                 lógica de click de siempre, solo cambia cómo se ve). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seguir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/seguir"
                app:icon="@drawable/ic_my_location" />

            <!-- Acciones de seguimiento MÚLTIPLE ("Seguir también"/"Detener todo"): antes dos
                 botones del mismo tamaño que "Seguir" en una fila aparte; ahora un menú contextual
                 para que no compitan visualmente con la acción primaria. Mismo criterio de
                 visibilidad que antes (solo si ya hay alguna unidad en seguimiento). -->
            <ImageButton
                android:id="@+id/btn_seguir_opciones"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/seguimiento_opciones"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone"
                app:tint="@color/mb_gray" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Cerrar (siempre visible aunque el contenido haga scroll; MapFragment la hace visible y le
         pone el listener). -->
    <ImageButton
        android:id="@+id/btn_cerrar_carta"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@android:string/cancel"
        android:padding="6dp"
        android:src="@drawable/ic_close_small"
        android:visibility="gone"
        app:tint="@color/mb_gray" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
