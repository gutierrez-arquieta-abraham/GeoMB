<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo CITI: pantalla de lista (fragment_lista.xml / fragment_favoritos.xml de la app de Indra):
     "Seleccione ruta", "Estaciones cercanas" y "Favoritos". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <include layout="@layout/bar_menu_citi" />

    <ListView
        android:id="@+id/citi_lista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/citi_lista_divisor"
        android:dividerHeight="0.67dp" />
</LinearLayout>
