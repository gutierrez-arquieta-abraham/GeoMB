<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ad_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Banner de AdMob (no invasivo, fijo abajo en TODAS las pantallas). El AdView se infla desde
         setContentView() dentro de onCreate(), mucho antes de que corra el código de
         cargarBanner() (que espera a MobileAds.initialize()/UMP); por eso adSize/adUnitId van
         AQUÍ en el XML y no solo en código: sin ellos, Android intenta medir el AdView antes de
         que el código alcance a fijarlos y truena ("Required XML attribute ... was missing").
         adUnitId debe coincidir con Config.AD_BANNER_UNIT_ID (ver @string/ad_banner_unit_id).
         Arranca oculto (visibility="gone"): MainActivity solo lo muestra si el anuncio carga, así
         nunca deja un hueco en blanco sin red o sin relleno. -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/ad_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:adSize="BANNER"
        app:adUnitId="@string/ad_banner_unit_id"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra inferior: BottomNavigationView estándar (Material 1.13) + menú/colores en
         res/menu,res/color. labelVisibilityMode="auto" (no "labeled" fijo): con 5 ítems en una
         pantalla angosta (~320-360dp) cada uno tiene ~64dp, insuficiente para que "Servicio" (la
         etiqueta más larga) no se corte/salte de línea si se fuerza el texto en los 5 a la vez;
         "auto" deja que Material muestre solo el ícono en los no seleccionados cuando no caben. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:labelVisibilityMode="auto"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
